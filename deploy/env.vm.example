# ── Irises — VM SECRETS file (template) ──────────────────────────────
# deploy/vm-bootstrap.sh copies this to /opt/irises/.env on the VM and auto-fills IMAGE,
# SITE_ADDRESS, the public URLs, and TOKEN_ENCRYPTION_KEY — you only add the API keys.
#
# This file holds ONLY secrets + this-VM values. It is chmod 600, lives only on the box,
# is NEVER committed, and the deploy NEVER overwrites it (so a push can't clobber your keys).
# All non-secret, tweakable config lives in deploy/app.env (committed, edited in your IDE).

# ── Compose substitution + this-deployment values (bootstrap fills these in) ──
IMAGE=us-central1-docker.pkg.dev/YOUR_PROJECT_ID/irises/irises:latest
SITE_ADDRESS=YOUR_VM_EXTERNAL_IP.nip.io
PUBLIC_BASE_URL=https://YOUR_VM_EXTERNAL_IP.nip.io
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_VM_EXTERNAL_IP.nip.io/oauth/google/callback
# 32-byte key used to encrypt Gmail refresh tokens (bootstrap generates this)
TOKEN_ENCRYPTION_KEY=

# ── LLM provider keys (REQUIRED to boot) ──
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Legacy DALL·E / deepseek paths only:
OPENAI_API_KEY=

# ── Data layer: Supabase (omit to use the in-memory dev fallback) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Gmail OAuth (client id isn't secret, but it's deployment-specific) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Gmail push (real-time Judge) ──
# Fully-qualified Pub/Sub topic Gmail publishes to (see deploy/gcp-setup.sh). Empty = push off,
# hourly backstop poll only. Must live HERE, not app.env (app.env loads later and would blank it).
GMAIL_PUBSUB_TOPIC=
# Shared secret for /webhook/gmail (bootstrap generates this). The Pub/Sub push subscription's
# endpoint URL must include it: https://<SITE_ADDRESS>/webhook/gmail?token=<GMAIL_PUSH_VERIFY_TOKEN>
GMAIL_PUSH_VERIFY_TOKEN=

# ── Diagnostics dashboard token (/debug) ──
DEBUG_TOKEN=

# ── Admin orchestration dashboard password (/dashboard). CHANGE THIS — never ship the default. ──
DASHBOARD_PASSWORD=change-me-strong-password
