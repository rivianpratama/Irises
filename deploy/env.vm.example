# ── Irises — VM SECRETS file (template) ──────────────────────────────
# Copy to /opt/irises/.env on the VM and fill in the values.
#
# This file holds ONLY secrets + this-VM values. It is chmod 600, lives only on the box,
# and is NEVER committed. All non-secret, tweakable config lives in deploy/app.env
# (committed, edited in your IDE).

# ── Compose substitution + this-deployment values ──
# Any image ref the VM can pull (or one you docker-load onto the box):
IMAGE=ghcr.io/YOUR_GITHUB_OWNER/irises:latest
# <YOUR_VM_EXTERNAL_IP>.nip.io for a zero-cost host, or a real domain pointed at the VM:
SITE_ADDRESS=YOUR_VM_EXTERNAL_IP.nip.io

# ── LLM provider keys (REQUIRED to boot) ──
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Data layer ──
# Nothing to set: state lives in the irises_state volume (IRISES_HOME=/data in the image —
# SQLite + per-user memory markdown). Back up the volume to back up Irises.

# ── Engine (the deep-work brain — see docs/ENGINES.md) ──
# OPS_BACKEND=hermes                # hermes | openclaw — unset = deep work offline (Convo still chats)
# HERMES_BASE_URL=http://127.0.0.1:8642
# HERMES_API_KEY=                   # operator-grade — keep secret
# OPENCLAW_URL=ws://127.0.0.1:18789
# OPENCLAW_TOKEN=                   # gateway.auth.token from the OpenClaw config (operator-grade)
# OPENCLAW_AGENT_ID=main
# OPENCLAW_CAPABILITIES=            # openclaw: comma list from web,inbox,files,code,media,scheduling (unset = unknown)
# HERMES_CAPABILITIES=              # hermes: same list — the operator's declaration; live /v1/toolsets discovery wins
# ENGINE_ONBOARDING=off             # skip the one-time engine-mode onboarding sent at boot (both engines)
ENGINE_PUSH_TOKEN=                  # guards POST /api/engine/push (engine→Irises proactive delivery)

# ── Diagnostics dashboard token (/debug) ──
DEBUG_TOKEN=

# ── Admin orchestration dashboard password (/dashboard) ──
DASHBOARD_PASSWORD=                 # unset = localhost-only; set a strong one in prod
