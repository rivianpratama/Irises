# ── Irises — app config (COMMITTED, synced on push) ──────────────────
# Non-secret, tweakable config. Edit in your IDE, commit, push — the deploy ships this
# to /opt/irises/app.env on the VM every push, so config changes sync automatically.
#
# NEVER put API keys / secrets here. Those live only in /opt/irises/.env on the VM and
# are never committed or overwritten by a deploy. On any overlapping key, THIS file wins.
#
# ⚠️ SLIM NOTE: deep work now runs on an external ENGINE (hermes-agent or OpenClaw — see
# docs/ENGINES.md; OPS_BACKEND + engine keys live in .env, not here). The role sections below
# for autonome / judge / reflexion / mm / ops_mm / ops_escalation and the email/Gmail knobs are
# INERT leftovers from the pre-engine era — nothing reads them anymore; kept only until the next
# config sweep so diffs against the predecessor repo stay reviewable.

# ── Server ──
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=512   # heap cap so the 1 GB e2-micro doesn't OOM
PORT=8080                               # Caddy proxies here; keep in sync with the Caddyfile

# ── Models — per-agent provider + model ─────────────────────────────────────
# Each agent picks a PRIMARY provider; the OTHER provider is the automatic fallback,
# used ONLY on a transient error (5xx / 429 / network) — never to silently switch models.
#   <AGENT>_PROVIDER          anthropic (default) | openrouter   — which provider runs first
#   <AGENT>_MODEL             Anthropic model slug   (primary when PROVIDER=anthropic, else fallback)
#   <AGENT>_MODEL_OPENROUTER  OpenRouter model slug  (primary when PROVIDER=openrouter, else fallback)
# The OpenRouter slug can be ANY OpenRouter model, not just Claude — e.g. openai/gpt-4o,
# google/gemini-2.5-pro, deepseek/deepseek-chat, meta-llama/llama-3.3-70b-instruct.
# Web search (Ops research) and PDF reading work on BOTH providers: Anthropic uses its native
# tools; OpenRouter uses its openrouter:web_search server tool + file-parser plugin (wired in
# src/llm/openrouterRequest.ts). Web search + PDF need a TOOLS-CAPABLE OpenRouter model — a model
# without "tools" in its supported_parameters silently can't call tools, which also breaks OPS/JUDGE.
# OpenRouter requires OPENROUTER_API_KEY (a secret in /opt/irises/.env).

# Convo — the real-time chat voice (fast, tool-capable, TEXT-ONLY). It can't see or hear, so when
# a turn carries a non-text file Convo delegates to MM (below) to read it. Convo's tools ride the JSON
# envelope (toolsViaJson — written tool_calls, no native tools param), so the Anthropic fallback slug
# MUST support structured outputs (output_config.format): Sonnet 5 does, Sonnet 4.6 does NOT.
# Primary is CONVO_MODEL_OPENROUTER; Anthropic (CONVO_MODEL, Sonnet 5) is the transient-error fallback.
CONVO_PROVIDER=openrouter
# Sonnet 5, NOT 4.6: 4.6 400s the structured-outputs enforcement per the MUST above and drops every
# Anthropic-fallback turn into the schema-less retry path.
CONVO_MODEL=claude-sonnet-5
# :nitro = OpenRouter's throughput sort — Convo is the hot path a user is actively waiting on, so
# route to the fastest provider for the slug. It resolves gracefully if no curated set exists.
CONVO_MODEL_OPENROUTER=openai/gpt-5.6-luna:nitro
# Reasoning effort for the real-time chat voice (env CONVO_EFFORT; low|medium|high|xhigh|max, or off).
# This ARMS reasoning on the OpenRouter lane, so the model spends chain-of-thought tokens against
# CONVO_MAX_TOKENS below — which is why that ceiling is non-binding (64000), so effort can never starve
# the reply. OpenRouter caps effort at 'high' on the wire; the Anthropic fallback (Sonnet 5) applies the
# full level via output_config.effort.
CONVO_EFFORT=high
# Output ceiling for Convo (env CONVO_MAX_TOKENS). A runaway backstop, NOT a budget — reasoning
# CoT can spend freely without ever hitting finish_reason=length. 64000 is safe because the Anthropic
# fallback lane STREAMS (see OPS_MAX_TOKENS note — non-streaming would reject anything above ~21.3k
# and silently kill the fallback); the OpenRouter primary caps far higher.
CONVO_MAX_TOKENS=64000
# Cache Convo's large, stable system prefix (~28k-token persona) on the Anthropic path. It only
# BILLS a difference when Convo is on the Anthropic lane — its transient-error fallback, or a
# deliberate CONVO_PROVIDER=anthropic flip, during which every Convo turn would otherwise run
# UNCACHED. On the OpenRouter primary lane the cache_control marker is a harmless ignored passthrough.
# Default on; set false to disable. (Contrast OPS_CACHE_SYSTEM=false below: Ops runs where it's moot.)
CONVO_CACHE_SYSTEM=true

# MM — the media agent, now USER-FACING. Convo delegates any non-text file (photo/video/voice
# memo/PDF/doc) here; MM ingests it NATIVELY on a media-capable model and voices Irises's reply
# ITSELF as JSON bubbles (no composer hop), plus a private `analysis` channel persisted for the
# other agents. Single pass, no research tools — file questions needing outside facts dangle the
# research, and the follow-up rides delegate_to_ops. OpenRouter-only for media turns (Anthropic has
# no native audio/video) — needs OPENROUTER_API_KEY. The MM_MODEL (Anthropic) slug is the fallback
# lane for image and document turns; audio/video never fall back (Anthropic has no native
# audio/video). MUST be structured-outputs capable (jsonBubbles envelope) — same rule as
# CONVO_MODEL; Sonnet 4.6 would 400 into the schema-stripped retry path. Leave PROVIDER=openrouter.
MM_PROVIDER=openrouter
MM_MODEL=claude-sonnet-5
# :nitro = OpenRouter's throughput sort — routes to the highest tokens/sec provider for the slug
# (equivalent to provider.sort="throughput"). Media reads are latency-sensitive, so favor speed.
MM_MODEL_OPENROUTER=google/gemini-3.6-flash:nitro
# Reasoning effort for the media agent (env MM_EFFORT; low|medium|high|xhigh|max, or off). MAX =
# highest per request; OpenRouter caps it to 'high' on the wire (gemini's own ceiling too), so this is
# effectively gemini's top effort. Arms reasoning on the OpenRouter lane. The Anthropic fallback lane
# (Sonnet 5, image/doc turns) supports effort natively — no strip needed.
MM_EFFORT=max
MM_THINKING=on                  # adaptive|on = extended thinking; off = disabled
# MM run pacing (optional; shown with defaults). MM runs SILENTLY — no progress pings — so the task
# timeout is the only backstop against a dangling holding line. One read+voice pass; no consult knobs.
MM_TASK_TIMEOUT_MS=240000
# 16384, not 8192: MM_EFFORT=max + MM_THINKING=on above spend chain-of-thought AGAINST this cap on
# both lanes, and MM writes the whole {could_not_open, analysis, bubbles} envelope in the SAME pass —
# reasoning over a photo/PDF plus the envelope can eat 8192 and come back cut off (or empty, which
# throws). Media turns also CANNOT fall back (Anthropic has no native audio/video), so there is no
# second lane to salvage a starved read. Output only costs what's generated — this is a runaway
# backstop, not a budget.
MM_MAX_TOKENS=16384
# Max RAW bytes per inlined audio/video before it's skipped (base64 inflates ~33%; heap is capped).
LLM_MAX_MEDIA_BYTES=10485760

# Ops-MM — the Ops engine's OWN media reader: audio/video EMAIL ATTACHMENTS opened via the Ops
# read_attachment tool (PDF/image/office/text attachments stay on the Ops model itself). This is
# independent of the MM agent — Ops stays multimodal for attachments it pulls from Gmail itself.
# Native-media like MM (OpenRouter-only, no fallback) but tuned independently, so changing one never
# silently changes the other. The Anthropic slug is an unused placeholder.
OPS_MM_PROVIDER=openrouter
OPS_MM_MODEL=claude-sonnet-4-6
OPS_MM_MODEL_OPENROUTER=google/gemini-3.6-flash:nitro
OPS_MM_THINKING=on              # adaptive|on = extended thinking; off = disabled
OPS_MM_EFFORT=xhigh             # low|medium|high|xhigh|max, or off
# OPS_MM_MAX_TOKENS=8192        # optional; falls back to 8192

# How long after the user SENT media it can still be recalled/re-attached (default 24h). When a text
# follow-up refers back to an earlier attachment, Convo delegates to MM with media_scope="earlier"
# and the stashed file is re-attached; older than this → Irises asks them to resend.
MEDIA_RECALL_TTL_MS=86400000

# Ops — the research/tool engine. Heavy tool + web_search + PDF user; on OpenRouter it MUST be a
# tools-capable model (see note above), else research/document reading break.
# The primary runs gpt-5.6-terra:exacto at OPS_EFFORT=medium — a LATENCY choice. Deep-research (-pro)
# models spend ~25-40s of reasoning PER step across 2-3 serialized steps, so easy tasks averaged
# minutes. terra is the STANDARD-reasoning variant: far less per-step latency and a smaller
# server-side browsing surface, so the cost-bomb risk is lower here than under a -pro slug.
# Hallucination safety does NOT come from effort — the deterministic fidelity grounding layer
# (ops/fidelity.ts) checks every hard fact against the tool corpus regardless of model/effort, and the
# terra-pro escalation leg still runs at full effort as the second-opinion net. Anthropic Opus 4.8
# (OPS_MODEL) stays the transient-error fallback. The guards below MUST stay armed regardless of
# model: OPS_WEB_SEARCH_MAX_USES, OPS_DAILY_TOKEN_CAP, OPS_TASK_TOKEN_BUDGET,
# OPENROUTER_MAX_TOOL_CALLS_DEFAULT.
# Revert: OPS_MODEL_OPENROUTER=openai/gpt-5.6-luna-pro:exacto + OPS_EFFORT=max (or OPS_PROVIDER=anthropic).
OPS_PROVIDER=openrouter
OPS_MODEL=claude-opus-4-8
# ⚠️ PRIMARY LANE (OPS_PROVIDER=openrouter). gpt-5.6-terra is a standard-reasoning model (billed
# $1/$6 per Mtok per budget.ts; confirm it lists "tools" in supported_parameters before deploy).
# Chosen for per-step latency; the guards below still bound any server-side browsing
# (OPS_WEB_SEARCH_MAX_USES + OPENROUTER_MAX_TOOL_CALLS_DEFAULT + the token budgets). Reminder of why
# the guards stay armed: under deep-research slugs OpenRouter runs server-side browsing unbounded and
# bills every internal pass as prompt tokens (a 5k-token request can bill millions). :exacto resolves
# gracefully if no curated provider set exists. Watch /dashboard.
OPS_MODEL_OPENROUTER=openai/gpt-5.6-terra:exacto
# Output ceiling: room for adaptive thinking + the ANSWER/SOURCE/FLAGS summary. High and non-binding
# (Ops output rarely approaches it — thinking is the main consumer). 64000 is safe because the
# Anthropic path STREAMS (callLLM.ts): the SDK rejects non-streaming requests above ~21.3k max_tokens
# (10-min guard) — a pre-streaming 64000 makes every Anthropic ops call throw instantly and silently
# reroutes 100% of Ops traffic to the OpenRouter fallback lane. If you ever revert the Anthropic path
# to non-streaming, this MUST drop to ≤20000.
OPS_MAX_TOKENS=64000
# Ops reasoning/caching/sampling knobs (apply to BOTH providers; OpenRouter is the experiment lane —
# flip OPS_PROVIDER=openrouter + point OPS_MODEL_OPENROUTER at any tools-capable model to A/B).
OPS_THINKING=adaptive            # adaptive|on = extended thinking; off = disabled
OPS_EFFORT=medium                # low|medium|high|xhigh|max — medium with the terra switch (latency). Reasoning stays ON (OPS_THINKING=adaptive); this trims per-step thinking time. Escalation stays at max. Raise back toward high if standard-task quality dips (fidelity grounding + escalation still backstop).
OPS_CACHE_SYSTEM=false           # cache the system prefix (Anthropic + OpenRouter-Anthropic)
# OPS_TEMPERATURE=               # float; IGNORED on Anthropic while thinking is on (set OPS_THINKING=off to use it)
# Step budgets: the email/document-grounded kinds (document_read/draft/general) get the larger
# budget — retrieval chains need room to search, read, open attachments, and broaden. web_research
# takes the flat budget. Multi-variant search keeps each step cheap.
# OPS_MAX_STEPS=8
# OPS_MAX_STEPS_EMAIL=12
# OPS_MIN_SEARCH_FORMULATIONS=3  # distinct searches required before a NO RESULT may finalize
# OPS_TASK_TIMEOUT_MS=240000     # wall-clock ceiling on ONE live Ops run (orchestrator deadline)
# OPS_READ_URL_TIMEOUT_MS=15000  # per-fetch timeout for the Ops read_url tool
# EMERGENCY LEVER: flip to false to kill Ops web search on BOTH lanes instantly (server-side search
# is the classic cost-bomb amplifier).
# OPS_WEB_SEARCH_ENABLED=true
OPS_WEB_SEARCH_MAX_USES=6        # caps server-side searches/request on both lanes — the amplifier guard
# Latency: run a step's tool calls concurrently (read-only tools in parallel; mutating tools —
# schedule_followup — stay sequential, in call order). Results reassemble in original order, so
# grounding/debrief are unchanged. false = the old strictly-sequential loop.
OPS_PARALLEL_TOOLS=true
# Deterministic fidelity grounding (ops/fidelity.ts): every hard fact in an Ops answer is checked
# against the tool corpus before it can surface.
# FIDELITY_ENFORCE=all           # all | hard (only hard facts) | off (compute + log only, no suppression)
# FIDELITY_LAYER2=on             # off = skip the classify-model rescue pass for paraphrased/relative facts

# ── Cost guards ─────────────────────────────────────────────────────────────
# Daily billed-token kill switches over the token_usage ledger (UTC day, 5-min cached — can
# overshoot one cache window). Tripping fails LOUD (nonFallbackable; Ops gives up, never
# escalates, never re-bills the other lane). The /dashboard LLM tab shows live spend vs these
# caps. Sized ~5-10x a normal day: smoke alarms, not throttles. 0/unset = OFF.
OPS_DAILY_TOKEN_CAP=10000000     # ops + ops_escalation combined
# Judge runs a per-inbound-email model, so it gets its own daily smoke alarm — independent of the
# global cap (whose trip kills every role). Sized ~10-20x a normal judge day; a tripped cap degrades
# judge to "not important" so mail flow continues, only proactive surfacing stops. Shown on the
# /dashboard LLM tab's judge card.
JUDGE_DAILY_TOKEN_CAP=4000000    # judge role alone
LLM_DAILY_TOKEN_CAP=20000000     # every role combined
# Per-task Ops token budget: each Ops/escalation leg gets its own fresh allowance incl. tool-internal
# calls; over → wrap up, give_up on a miss.
OPS_TASK_TOKEN_BUDGET=750000
# Always-on server-tool ceiling on EVERY OpenRouter request (code default 8; 0 = omit the field).
# Bounds server-side/internal browsing even on requests with NO web_search tool — the gap a
# deep-research model would otherwise ride at OpenRouter's own default of 30.
# OPENROUTER_MAX_TOOL_CALLS_DEFAULT=8
# Always-on guards, shown with their code defaults (src/llm/budget.ts, src/agents/ops/capTool.ts,
# src/services/attachments.ts, src/services/gmail.ts):
# LLM_MAX_INPUT_TOKENS_EST=150000    # per-call estimated text-input ceiling (base64 exempt — byte caps below)
# OPS_TOOL_RESULT_CAP=20000          # chars of one tool result forwarded to the model (head+tail)
# OPS_MESSAGES_CHAR_CAP=300000       # total ops-loop context; over → oldest tool results evicted
# OPS_MAX_TOOL_CALLS_PER_STEP=6      # parallel tool calls run per step; the rest are named + dropped
# MAX_PDF_BYTES=8388608              # PDF read/extraction byte cap (attachments.ts)
# JUDGE_RUN_MAX=50                   # inbound emails judged per run; storms drain in chunks
# Optional OpenRouter provider unit-price FILTER ($/Mtok) — drift protection, NOT a spend cap
# (a cost bomb is volume at an ordinary unit price):
# OPENROUTER_MAX_PRICE_PROMPT=
# OPENROUTER_MAX_PRICE_COMPLETION=
# Dashboard OpenRouter credit-runway warning floor ($). The /dashboard LLM tab's Today strip shows
# the live balance and turns it red below this. When OpenRouter runs out of credits it returns 402
# on every call; OpenRouter-primary roles (convo/judge/…) then degrade to their Anthropic fallback
# lane (see fallbackPolicy.ts) — this card is the heads-up to top up before that happens. Default 5.
# OPENROUTER_CREDITS_WARN_USD=5

# Ops failure escalation ("second opinion"). When a first Ops run FAILS (times out, hits a provider
# snag, or comes back ungrounded/empty for a researchable reason), a cheap triage step decides: ask
# the user for a missing detail, OR run ONE more look on the model below with an enriched brief (what
# was already researched + why it failed + what to dig into). One escalation per attempt. A budget-
# tripped run gives up and never escalates — a second max-effort loop is the one thing a tripped
# breaker must not buy. Tools-capable OpenRouter slug REQUIRED — confirm gpt-5.6-terra-pro lists "tools"
# in supported_parameters on OpenRouter before deploy (a non-tools slug silently breaks the loop).
# ENABLED=false = shadow mode: triage still runs + records ops:triage on /dashboard, but no second runs.
OPS_ESCALATION_ENABLED=true
# Now that the PRIMARY lane is the lighter terra (standard reasoning), escalation is deliberately the
# deep-research -pro class — a genuinely stronger second opinion on the rare miss/failure the first
# pass couldn't crack.
# ⚠️ HISTORY: a -PRO model at max effort is the classic cost bomb (one escalated -pro step can bill
# millions of input tokens via unbounded internal browsing). It is safe to run HERE only because ALL
# of these guards remain armed on the escalation lane and MUST stay so: a fresh OPS_TASK_TOKEN_BUDGET
# per leg, the shared OPS_DAILY_TOKEN_CAP bucket, OPS_ESCALATION_TIMEOUT_MS, one-shot triage,
# OPS_WEB_SEARCH_MAX_USES, and OPENROUTER_MAX_TOOL_CALLS_DEFAULT. Escalation only fires on a real
# failure/miss (triage-gated), so its frequency is low — watch role='ops_escalation' spend on the
# /dashboard LLM tab. Anthropic Opus 4.8 (OPS_ESCALATION_MODEL) stays the transient-error fallback.
# NOTE: a transient LLM lane error (llm_error/rate_limited) does NOT buy this expensive leg directly — it
# takes the cheap same-role OPS_RETRY_* path below FIRST. But if that retry comes back a RESEARCHABLE miss
# (timeout, tool_errors, fidelity_suppressed, empty→research_gap), triage ladders it up to ONE escalation
# here. So escalation fires for researchable misses (a stronger model helps), reached either directly on a
# first-pass miss or via the retry ladder — never for a pure transient error (a stronger model can't fix
# infra). Worst-case leg chain: primary → retry → escalation.
# Revert: OPS_ESCALATION_MODEL_OPENROUTER=openai/gpt-5.6-sol-pro:exacto (or PROVIDER=anthropic).
OPS_ESCALATION_PROVIDER=openrouter
OPS_ESCALATION_MODEL=claude-opus-4-8
OPS_ESCALATION_MODEL_OPENROUTER=openai/gpt-5.6-terra-pro:exacto
OPS_ESCALATION_TIMEOUT_MS=600000
OPS_ESCALATION_THINKING=adaptive
OPS_ESCALATION_EFFORT=max         # "pro" is not a valid level; see OPS_EFFORT
OPS_ESCALATION_CACHE_SYSTEM=false
# OPS_ESCALATION_MAX_TOKENS=       # falls back to OPS_MAX_TOKENS when unset
# OPS_ESCALATION_TEMPERATURE=      # float; ignored while thinking is on

# Cheap same-role recovery for a TRANSIENT lane failure (llm_error / rate_limited): instead of the
# expensive escalation leg, triage runs ONE more pass on the SAME ops role/model (medium effort, the cheap
# lane) — callLLM already tries both providers per call (and each SDK retries ~2x), so a blip that has
# since cleared is recovered at a fraction of the cost of a terra-pro max-effort escalation, and the same
# model means no document-parse engine swap (preserves extracted-fact fidelity). If the retry itself comes
# back a RESEARCHABLE miss, triage ladders it up to one escalation (see the OPS_ESCALATION note above).
# One retry per attempt, bounded by the same per-leg budget + timeout + tool ceiling as the primary.
# ENABLED=false → a transient error skips the retry and degrades straight to the "transient snag" beat (it
# does NOT escalate — a stronger model can't fix an infra blip). Watch 'ops:retry' / 'ops:retry-result' on /dashboard.
OPS_RETRY_ENABLED=true

# Ops progress reporting — how often/many mid-run "still on it" reassurances can fire.
OPS_PROGRESS_QUIET_MS=300000
OPS_PROGRESS_GAP_MS=300000
OPS_MAX_PROGRESS_PINGS=1

# Classify — fast routing/labeling calls (Haiku-tier, ~20 tokens).
CLASSIFY_PROVIDER=openrouter
CLASSIFY_MODEL=claude-sonnet-4-6
# :nitro = throughput sort — a hot-path micro-call on every turn, so route to the fastest provider.
CLASSIFY_MODEL_OPENROUTER=openai/gpt-5.6-luna:nitro
CLASSIFY_THINKING=off            # adaptive|on = extended thinking; off = disabled
# OFF, and raising CLASSIFY_MAX_TOKENS cannot make it safe: every classify caller passes its OWN
# per-call max_tokens, which BINDS over the role ceiling — 20 (Convo's group-chat router and the
# ALLOW/REJECT preference screen), 100 (Ops fidelity layer 2), 500 (Ops triage), 900 (dossier
# rewrite). Effort spends chain-of-thought against THOSE numbers on both lanes, so the whole budget
# goes to reasoning and the reply arrives empty: the ALLOW/REJECT screen then fails OPEN, group-chat
# routing and fidelity L2 fail closed, triage returns nothing, and the dossier rewrite persists half
# a document. Arm it only after the per-call overrides are raised at their call sites.
CLASSIFY_EFFORT=off               # low|medium|high|xhigh|max, or off (per-call caps 20/100/500/900 bind over CLASSIFY_MAX_TOKENS)
# CLASSIFY_MAX_TOKENS=20         # optional; falls back to 20 (one word BY DESIGN — an output constraint, not a budget)

# Autonome — Irises's proactive outreach voice (Haiku-tier, text only).
AUTONOME_PROVIDER=openrouter
AUTONOME_MODEL=claude-sonnet-4-6
# balanced (default routing, no variant): runs in a background job, not while a user waits, and does no
# tool work — neither :nitro's speed nor :exacto's tool-accuracy earns its keep here.
AUTONOME_MODEL_OPENROUTER=openai/gpt-5.6-luna:exacto
AUTONOME_THINKING=on            # adaptive|on = extended thinking; off = disabled
AUTONOME_EFFORT=high              # low|medium|high|xhigh|max, or off
# AUTONOME_MAX_TOKENS=8192       # optional; falls back to 8192

# Judge — inbound-email discernment + proactive surfacing.
JUDGE_PROVIDER=openrouter
JUDGE_MODEL=claude-sonnet-4-6
# Bounded by: JUDGE_MAX_TOKENS (single-shot, no tool loop, web search off), the always-on
# OPENROUTER_MAX_TOOL_CALLS_DEFAULT ceiling, JUDGE_DAILY_TOKEN_CAP, JUDGE_RUN_MAX=50, and the global
# cap. Anthropic Sonnet 4.6 (JUDGE_MODEL) stays the transient-error fallback lane.
JUDGE_MODEL_OPENROUTER=openai/gpt-5.6-sol
JUDGE_THINKING=on               # adaptive|on = extended thinking; off = disabled
JUDGE_EFFORT=medium                 # low|medium|high|xhigh|max, or off (⚠ raise JUDGE_MAX_TOKENS if armed — 1000 cap starves)
JUDGE_MAX_TOKENS=8000            # raised from the 1000 default: thinking+effort spend CoT before content

# Judge delivery mode — ONE daily digest, not per-arrival pings.
# The daily pass wakes at JUDGE_DIGEST_HOUR local (per user's tz, jittered by a stable per-handle
# minute), judges everything that landed since the last pass, and voices ONE consolidated message.
# Real-time surfacing is OFF by default: an inbound email no longer interrupts the user the moment it
# arrives. Flip JUDGE_REALTIME_ENABLED=true to restore instant per-arrival pings (both modes can run
# at once; the digest ring dedupes so an email is surfaced at most once, ever).
JUDGE_DAILY_ENABLED=true         # false = kill the whole daily-digest feature
JUDGE_DIGEST_HOUR=8              # local hour (0-23) the digest fires
JUDGE_REALTIME_ENABLED=false     # true = also surface each important email the moment it lands
# JUDGE_INACTIVE_DAYS=3          # skip a user's digest at zero LLM cost after this many quiet days

# Fallfirm — the fallback+confirm voicer (Haiku-tier). Re-voices a failure/confirmation in Irises's
# tone whenever a primary agent couldn't say it itself (Convo tool outcomes, a composer/autonome/judge
# miss, an OAuth connect). If ITS call fails too, code drops to the tiny floor in fallfirm/floor.ts.
FALLFIRM_PROVIDER=openrouter
FALLFIRM_MODEL=claude-sonnet-4-6
# :nitro = throughput sort — the recovery voicer runs AFTER a failure while the user waits, so speed wins.
FALLFIRM_MODEL_OPENROUTER=openai/gpt-5.6-luna:nitro
FALLFIRM_THINKING=off            # adaptive|on = extended thinking; off = disabled
FALLFIRM_EFFORT=high              # low|medium|high|xhigh|max, or off
# FALLFIRM_MAX_TOKENS=8192       # optional; falls back to 8192

# Reflexion — the memory curator (daily reflection at local midnight, Convo-delegated memory
# updates, conservative self-wakes ≤6/day). Strongest tier by deliberate decision: curation errors
# are permanent and compounding. Fully silent: never sends a message. REFLEXION_ENABLED=false kills
# the runner branch, the daily seed, and the Convo delegate tool in one switch.
REFLEXION_ENABLED=true
REFLEXION_PROVIDER=openrouter
REFLEXION_MODEL=claude-opus-4-8
# balanced (default routing, no variant): a silent background curator where accuracy > latency — no
# variant fits.
REFLEXION_MODEL_OPENROUTER=openai/gpt-5.6-sol
REFLEXION_THINKING=adaptive
REFLEXION_EFFORT=medium
REFLEXION_CACHE_SYSTEM=true
# Safe over the streaming Anthropic path (see OPS_MAX_TOKENS note); on a non-streaming path any value
# >21.3k makes every Reflexion run silently fall back to OpenRouter.
REFLEXION_MAX_TOKENS=32000
REFLEXION_MAX_STEPS=12
REFLEXION_TASK_TIMEOUT_MS=300000
REFLEXION_WAKE_CAP=6
# Reflexion-Delegated — the Convo `update_memory` path only (a user explicitly asked Irises to
# remember/adjust something on the live turn), split from the silent daily + self-wake passes. That is
# a scoped, user-triggered write, so it runs the lighter standard-reasoning tier — Terra (~1/5 Sol's
# per-token cost) instead of Sol. Any REFLEXION_DELEGATED_* left unset INHERITS the base REFLEXION_*
# value above, so removing this line reverts the delegated path to the daily tier.
REFLEXION_DELEGATED_MODEL_OPENROUTER=openai/gpt-5.6-terra
REFLEXION_DELEGATED_PROVIDER=openrouter    # inherits REFLEXION_PROVIDER when unset
REFLEXION_DELEGATED_MODEL=claude-opus-4-8  # Anthropic fallback slug; inherits REFLEXION_MODEL when unset
REFLEXION_DELEGATED_EFFORT=medium          # low|medium|high|xhigh|max; inherits REFLEXION_EFFORT when unset
REFLEXION_DELEGATED_THINKING=adaptive      # inherits REFLEXION_THINKING when unset
REFLEXION_DELEGATED_MAX_TOKENS=32000       # inherits REFLEXION_MAX_TOKENS when unset
# REFLEXION_DELEGATED_CACHE_SYSTEM=        # inherits REFLEXION_CACHE_SYSTEM when unset
# REFLEXION_DELEGATED_TEMPERATURE=         # inherits REFLEXION_TEMPERATURE when unset

# Transcribe — voice-memo transcription. OpenRouter-only (needs an audio-capable model).
# :nitro = throughput sort — transcription is latency-sensitive (a user waiting on their voice memo).
TRANSCRIBE_MODEL=google/gemini-3.5-flash-lite:nitro
# Completion cap for one memo (default 4096, was a hardcoded 1024 ≈ 45s of speech). This call runs on
# the raw SDK outside callLLM, so it has no fallback lane: a memo over the cap comes back truncated
# and is returned with a "[…cut off…]" marker appended rather than dropped. Raise for long memos.
# TRANSCRIBE_MAX_TOKENS=4096

# OpenRouter PDF parsing engine (only used when a PDF is read via an OpenRouter model):
# cloudflare-ai (free, default) | mistral-ocr (paid, best for scans) | native (file-native models).
OPENROUTER_PDF_ENGINE=cloudflare-ai

# ── Reply pacing ──
# Burst batching (message-driven ROLLING window; does NOT use the flaky user typing indicator):
# wait for quiet after the LAST message; every new message RESETS that window. The window GROWS
# with the burst — base BATCH_SETTLE_MS, +BATCH_SETTLE_INCREMENT_MS per extra message, capped at
# BATCH_MAX_SETTLE_MS (e.g. 5s, 6s, 7s, … up to 20s) — so the more they're firing off, the longer
# we wait for the next one. No total-time ceiling: the whole burst is compiled, answered once quiet.
BATCH_SETTLE_MS=5000
BATCH_SETTLE_INCREMENT_MS=1000
BATCH_MAX_SETTLE_MS=20000
USER_QUIET_WAIT_MS=600
# PAUSE_WHILE_TYPING=false       # true = hold our send while the user is mid-typing (currently inert: no channel feeds inbound typing events)
# Simulated typing ("fast but human"): chars/TYPING_CPM per bubble, clamped to
# [TYPING_DELAY_MIN_MS, TYPING_DELAY_MAX_MS] with ±TYPING_JITTER_PCT% wobble. The FIRST bubble is
# additionally capped at TYPING_FIRST_BUBBLE_MAX_MS — the user already sat through batching + the
# LLM call with dots showing, so it lands ~1s after the model answers. (The old 190 CPM / 10s cap
# meant every 32+ char bubble waited the full 10s → ~30s per 3-bubble reply, pure sleep.)
# Applies to every channel, web SSE included.
TYPING_CPM=800
TYPING_DELAY_MAX_MS=3000
TYPING_DELAY_MIN_MS=600
TYPING_FIRST_BUBBLE_MAX_MS=800
TYPING_JITTER_PCT=15
TYPING_REFRESH_MS=2000
# FOLLOWUP_VOICE_TIMEOUT_MS=120000  # ceiling on voicing ONE queued follow-up under the per-chat send lock
# CONTACT_CARD_PROMO=false          # true = re-share Irises's contact card every N messages (off: reads as self-promo)
# CONTACT_CARD_INTERVAL=5           # N, when the promo above is on (the first-message share always happens)

# ── Background jobs ──
# Autonome runner: fires all due automations (user reminders, email-triaged
# nudges, Ops follow-ups) and voices each through Irises's proactive persona.
# Replaces the old deadline sweeper. 1-min tick so wall-clock reminders land on time.
AUTONOME_ENABLED=true
AUTONOME_INTERVAL_MS=60000
AUTONOME_BATCH=10
# Scheduled Ops runs register in the coordination map like live delegations. OPS_TIMEOUT bounds one
# scheduled run (MUST stay < the 5-min stale window and 10-min claim lease; falls back to
# OPS_TASK_TIMEOUT_MS then 240000). DUP_DEFER is how far a needsOps row is pushed when the identical
# research is already running live, so it re-runs fresh instead of double-spending.
AUTONOME_OPS_TIMEOUT_MS=240000
AUTONOME_DUP_DEFER_MS=300000
# ROUTING_GATE=on                # off = disable the post-turn safety net that force-delegates a turn whose bubbles promised a look-up
# MEMORY_SHORT_SWEEP_GRACE_MS=172800000  # how long PAST expiry short-term rows survive (~72h physical retention) so Reflexion always finds a full day

# ── Email Judge + Gmail push ──
# New mail triggers the Judge in real time via Gmail users.watch -> Cloud Pub/Sub -> /webhook/gmail.
# GMAIL_PUBSUB_TOPIC is the fully-qualified topic (projects/<id>/topics/<name>); without it, push is
# OFF and only the backstop poll runs. GMAIL_PUBSUB_TOPIC and GMAIL_PUSH_VERIFY_TOKEN both live in
# /opt/irises/.env (VM secrets). Do NOT add them here even as empty placeholders: compose loads this
# file AFTER the VM .env, so an active `KEY=` line here blanks the VM's value inside the container.
# GMAIL_PUBSUB_TOPIC=projects/<id>/topics/<name>   (set in /opt/irises/.env)
GMAIL_WATCH_RENEWAL_MS=86400000        # re-register each watch daily (Gmail expires it in <=7d)
EMAIL_BACKSTOP_ENABLED=true            # slow safety-net poll for dropped push notifications
EMAIL_BACKSTOP_INTERVAL_MS=3600000     # hourly
EMAIL_POLL_MAX=25                      # max messages per watermark-fallback scan
# Watch staleness watchdog: if the backstop discovers mail while push has been silent this long,
# the watch is presumed silently dead and reset (stop + re-watch). Gmail watches are documented
# to die early sometimes; this is the standard fallback.
# GMAIL_WATCH_WATCHDOG_MS=21600000     # 6h

# ── Local mail search index (the emails table search_inbox_local reads) ──
# Every message the pipeline fetches is upserted; the backfill fills history (inbox+sent+archive,
# paced against the 6,000 quota-units/user/min budget). Substring-capable, quota-free retrieval.
# EMAIL_SEARCH_INDEX=on                # off = disable ensure-at-boot/connect backfills
# EMAIL_SEARCH_BACKFILL_MAX=600        # messages fetched per backfill run
# EMAIL_INDEX_SENT=true                # false = skip the recent-sent sweep on the backstop tick
# GMAIL_SEARCH_DEFAULT_WINDOW_DAYS=365 # live-search default window when the model gives no date
# GMAIL_RETRY_ATTEMPTS=3               # transient-error retries per Gmail API call
# GMAIL_DOCS_PATH=                     # override the on-disk Gmail API reference the Ops tools cite

# ── Diagnostics (the DEBUG_TOKEN is a secret in /opt/irises/.env) ──
DIAGNOSTICS_ENABLED=true
# Per-string cap on recorded payloads shown in /debug + /dashboard. 0 = unlimited (verbatim,
# byte-for-byte). Only the diagnostics COPY is ever capped — the API always gets the full prompt,
# and token_usage (the forensics ledger with per-call latency/token counts) is a separate DB table,
# unaffected. 8000 bounds the synchronous per-call deep-clone of 64k-token wire responses
# (main-thread CPU + heap churn on the 1 GB VM). Set 0 to restore verbatim trace payloads.
DIAGNOSTICS_STR_CAP=8000
# In-memory trace ring sizing + the persisted turn history (all optional; code defaults shown):
# DIAGNOSTICS_TURNS_PER_CHAT=20        # turns retained per chat in the live trace buffer
# DIAGNOSTICS_EVENTS_PER_TURN=400      # events retained per turn
# DIAGNOSTICS_TURN_IDLE_MS=120000      # idle gap that closes a turn
# DIAGNOSTICS_PERSIST_RAW=false        # true = persist raw wire payloads with the turn history
# DIAGNOSTIC_HISTORY_KEEP=50           # persisted turns kept per chat
# DIAGNOSTIC_HISTORY_MAX_AGE_DAYS=30   # age-out for persisted turns

# ── Error log (the /dashboard Errors tab) ──
# Every thrown/logged failure is folded by signature and persisted. Pruned on a 6h interval.
# ERROR_LOG_MAX_AGE_DAYS=30
# ERROR_LOG_KEEP_ROWS=20000

EMAIL_BACKFILL_ON_BOOT=true
