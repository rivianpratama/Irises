{
  "name": "irises",
  "version": "1.0.0",
  "description": "Irises — a private, general, casual do-anything assistant. A multi-agent brain reachable over a web debug chat, iMessage (Linq Blue), and (prepared) Telegram.",
  "main": "dist/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rivianpratama/Irises.git"
  },
  "keywords": [
    "assistant",
    "ai",
    "claude",
    "anthropic",
    "multi-agent",
    "imessage",
    "telegram",
    "chatbot",
    "typescript"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc && cpx \"src/agents/**/*.md\" dist/agents && cpx \"src/**/*.txt\" dist",
    "build:web": "npm --prefix web run build",
    "copy:context": "cpx \"src/agents/**/*.md\" dist/agents && cpx \"src/**/*.txt\" dist",
    "start": "node dist/index.js",
    "chat": "tsx scripts/irises-chat.ts",
    "install:web": "npm --prefix web install",
    "test": "cross-env TZ=UTC tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.108.2",
    "cron-parser": "^4.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "googleapis": "^173.0.0",
    "jsonrepair": "^3.15.0",
    "nodemailer": "^9.0.3",
    "officeparser": "^5.1.1",
    "openai": "^6.16.0",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "cpx2": "^9.0.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
