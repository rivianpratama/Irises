# ── Irises — LOCAL .env (ALL OPTIONAL — overrides + local secrets) ──────────────
# You usually DON'T need this file. When Irises boots on top of a hermes/OpenClaw engine it
# auto-detects the backend (OPS_BACKEND), reuses the engine's API key, and inherits the engine's
# model — no .env required. This file is only for (a) OVERRIDING something, or (b) the debug path
# of running Irises standalone with no engine (where you must supply your own LLM key).
#
# Config layers LOWEST → HIGHEST:
#   1. deploy/app.env  — committed baseline (models, pacing, intervals), the SAME file prod uses
#   2. engine discovery — fills/updates OPS_BACKEND, engine key, and the model from your engine
#   3. this local .env  — layered ON TOP, WINS over both (so anything you set here is final)
# Don't duplicate deploy/app.env knobs here — edit those in deploy/app.env so the change also
# applies in prod. Put here only local secrets and the handful of values that MUST differ locally.

# ── Local-only overrides (these SHOULD differ from prod) ──
# DATA_BACKEND=memory               # ephemeral mode: nothing persists (default: SQLite + memory
#                                   # files under IRISES_HOME, ~/.irises — durable across restarts)
# IRISES_HOME=~/.irises             # where the local store lives (irises.db + memories/)
# IRISES_CYCLE_ANCHOR=2026-01-01    # "day 1" of Irises's internal 28-day affect cycle (ISO date).
#                                   # Never surfaced to the user; only sets the hidden mood-baseline
#                                   # phase math. Default 2026-01-01 if unset.
NODE_ENV=development

# ── Engine (the deep-work brain — see docs/ENGINES.md) ──
# ALL AUTO-DERIVED AT BOOT when an engine is installed — set these only to override.
# OPS_BACKEND=hermes                # hermes | openclaw — AUTO-DETECTED; set to force one. Unset + no
#                                   # engine found = deep work offline (Convo still chats).
#                                   # OPS_BACKEND=off  → DEBUG/standalone: force offline + skip all
#                                   # engine discovery, even if an engine is installed on this machine.
# ENGINE_MODEL_INHERIT=off          # stop inheriting the engine's model (keep Irises's own models); default on
# HERMES_BASE_URL=http://127.0.0.1:8642
# HERMES_API_KEY=                   # API_SERVER_KEY from ~/.hermes/.env — auto-reused (operator-grade — keep secret)
# OPENCLAW_URL=ws://127.0.0.1:18789
# OPENCLAW_TOKEN=                   # gateway.auth.token from the OpenClaw config — auto-reused (operator-grade)
# OPENCLAW_AGENT_ID=main
ENGINE_PUSH_TOKEN=                  # guards POST /api/engine/push (engine→Irises proactive delivery)
                                    # (the engine's job environment needs the SAME value as IRISES_PUSH_TOKEN)
# PROACTIVE_DEDUPE_WINDOW_MS=1800000  # how long one proactive dedupe key stays taken (engine retries)
# ENGINE_TIMEOUT_MS=225000          # per-engine-call budget (default: OPS_TASK_TIMEOUT_MS − 15s)
# ENGINE_MAX_CONCURRENT=2           # engine-call semaphore

# ── Channels ──
# Web / CLI debug chat (talk to Irises in the browser or the terminal via `npm run chat`). Served from web/.
WEB_ENABLED=true
# WEB_DEBUG_HANDLE=web:guest        # synthetic single-user identity for the web debug channel
# WEB_DEBUG_CHAT_ID=web:debug       # synthetic chat id the web channel routes to
# Bridge mode — Irises fronts the engine's OWN messaging (WhatsApp / Telegram / Signal / …). It turns
# on automatically when an engine is configured above (OPS_BACKEND) and its irises-bridge plugin is
# installed; nothing to set here. See docs/ENGINES.md.

# ── Local/dev secrets (never committed) ──
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEBUG_TOKEN=                        # gates /debug and the web chat channel; unset = localhost-only
DASHBOARD_PASSWORD=                 # password for the /dashboard admin GUI; unset = localhost-only (set a strong one in prod)

# Updates: the server checks the git remote for a newer build and can mention it in chat; apply with
# `bash scripts/update.sh` OR just tell Irises "update yourself" in chat. Knobs (defaults in
# deploy/app.env): UPDATE_CHECK_ENABLED, UPDATE_CHECK_INTERVAL_MS, UPDATE_CHECK_BRANCH,
# UPDATE_ANNOUNCE_ENABLED, UPDATE_ANNOUNCE_ACTIVE_WINDOW_MS, UPDATE_SELF_ENABLED.

# Need to override a baseline knob just for local? You can add any key from deploy/app.env
# here (e.g. CONVO_MODEL=claude-haiku-4-5 to test cheaper) — it wins over deploy/app.env.
# Ops transient-error retry (cheap second pass on the engine after an llm_error):
# OPS_RETRY_ENABLED (default true; false = a transient error degrades to the "transient snag" beat, no retry).
# Ops progress reporting: OPS_PROGRESS_QUIET_MS (silence before first ping, default 300000),
# OPS_PROGRESS_GAP_MS (min spacing between pings, default 300000), OPS_MAX_PROGRESS_PINGS (hard cap
# on mid-run updates across all legs, default 1).
# Cost guards (defaults in deploy/app.env): LLM_DAILY_TOKEN_CAP, OPS_DAILY_TOKEN_CAP,
# OPS_TASK_TOKEN_BUDGET, OPENROUTER_MAX_TOOL_CALLS_DEFAULT, OPENROUTER_MAX_PRICE_PROMPT/_COMPLETION.
# OPENROUTER_CREDITS_WARN_USD=5     # /dashboard LLM tab turns the OpenRouter balance card red below this ($)
