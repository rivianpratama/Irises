+        "    out[name] = replyTargetOf(msg);\n"
+        "  }\n",
+        _REPLY_CASES,
+    )
+
+
+def test_patched_shape_preserves_linkage(replies: Dict[str, Any]) -> None:
+    rt = replies["patched_shape"]
