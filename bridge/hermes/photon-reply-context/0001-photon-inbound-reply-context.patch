+    assert rt["id"] == "spc-msg-T"
+    assert rt["target"] is not None
+    assert rt["target"]["direction"] == "outbound"
+    assert rt["target"]["content"] == {"type": "text", "text": "earlier"}
+    # The inner content is what the sidecar should normalize/forward.
+    assert rt["content"] == _INNER
+    assert rt["threadRootId"] is None
+    assert rt["part"] is None
+
+
