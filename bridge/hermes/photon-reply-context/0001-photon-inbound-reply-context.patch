diff --git a/plugins/platforms/photon/sidecar/patch-spectrum-reply-target.mjs b/plugins/platforms/photon/sidecar/patch-spectrum-reply-target.mjs
new file mode 100644
index 0000000..5b07f80
--- /dev/null
+++ b/plugins/platforms/photon/sidecar/patch-spectrum-reply-target.mjs
@@ -0,0 +1,150 @@
+#!/usr/bin/env node
+// Patch spectrum-ts' iMessage provider until upstream preserves Apple's reply
+// linkage. `@photon-ai/advanced-imessage` hands the provider a raw record that
+// already carries `replyTargetGuid` (the exact bubble the human tapped),
+// `threadOriginatorGuid` (the thread's root bubble) and
+// `threadOriginatorPart`, but `buildMessageBase` — the single helper every
+// emitted message is spread from — copies only direction, sender, space and
+// timestamp, so the linkage never reaches Hermes.
+//
+// One anchor is enough: `...base` is spread into every message built by
+// `toInboundMessages`, `rebuildFromAppleMessage` and `buildAttachmentMessage`,
+// so rewriting the base covers text, attachment and group paths alike. The
+// added `replyTo` is spread in conditionally, so messages that are not replies
+// keep their exact previous shape.
+//
+// The published output is tab-indented; the anchor below matches that byte for
+// byte and fails loudly if a future spectrum-ts reshapes the helper. It runs
+// from `postinstall` alongside patch-spectrum-mixed-attachments.mjs, which
+// touches disjoint anchors (the two inbound mappers), so the pair composes in
+// either order and each is a no-op on a second run.
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const MARKER =
+  "Hermes patch: Preserve Apple reply linkage (replyTargetGuid/threadOriginatorGuid)";
+
+// spectrum-ts >= 12 maps the linkage itself. Either shape — the helper's
+// declaration or a call to it — means upstream got there first, so stand down
+// instead of stacking a second mapping on top. Neither string can match this
+// script's own output (it emits `message.replyTargetGuid ??` / `||` only).
+const UPSTREAM_HINTS = ["replyTargetGuid(", "const replyTargetGuid"];
+
+const ANCHOR = `const buildMessageBase = (message, chatGuidHint, timestamp, phone) => {
+\tconst chat = resolveChatGuid(message, chatGuidHint);
+\treturn {
+\t\tdirection: message.isFromMe ? "outbound" : "inbound",
+\t\tsender: toSenderRef(message.sender),
+\t\tspace: {
+\t\t\tid: chat,
+\t\t\ttype: chatTypeFromGuid(chat),
+\t\t\tphone
+\t\t},
+\t\ttimestamp
+\t};
+};`;
+
+const REPLACEMENT = `const buildMessageBase = (message, chatGuidHint, timestamp, phone) => {
+\tconst chat = resolveChatGuid(message, chatGuidHint);
+\treturn {
+\t\tdirection: message.isFromMe ? "outbound" : "inbound",
+\t\tsender: toSenderRef(message.sender),
+\t\tspace: {
+\t\t\tid: chat,
+\t\t\ttype: chatTypeFromGuid(chat),
+\t\t\tphone
+\t\t},
+\t\ttimestamp,
+\t\t// Hermes patch: Apple reply linkage. replyTargetGuid = the exact tapped bubble; threadOriginatorGuid = thread root.
+\t\t...(message.replyTargetGuid || message.threadOriginatorGuid ? { replyTo: {
+\t\t\tid: message.replyTargetGuid ?? message.threadOriginatorGuid,
+\t\t\tthreadRootId: message.threadOriginatorGuid ?? null,
+\t\t\tpart: message.threadOriginatorPart ?? null
+\t\t} } : {})
+\t};
+};`;
+
+function scriptDir() {
+  return path.dirname(fileURLToPath(import.meta.url));
+}
+
+function replaceOnce(source, from, to, label) {
+  const count = source.split(from).length - 1;
+  if (count !== 1) {
+    throw new Error(`expected exactly one ${label} match, found ${count}`);
+  }
+  return source.replace(from, to);
+}
+
+export function patchSpectrumReplyTarget(root = scriptDir()) {
+  const dist = path.join(
+    root,
+    "node_modules",
+    "@spectrum-ts",
+    "imessage",
+    "dist"
+  );
+  if (!fs.existsSync(dist)) {
+    throw new Error(`@spectrum-ts/imessage dist not found: ${dist}`);
+  }
+  const files = fs.readdirSync(dist)
+    .filter((name) => name.endsWith(".js"))
+    .map((name) => path.join(dist, name));
+
+  for (const file of files) {
+    const raw = fs.readFileSync(file, "utf8");
+    // Normalize to LF for matching so the patch works regardless of the
+    // checkout's line-ending style (Windows git autocrlf produces CRLF,
+    // which would otherwise defeat the \n-based search strings). The
+    // original EOL style is restored on write.
+    const CR = String.fromCharCode(13);
+    const CRLF = CR + "\n";
+    const usedCRLF = raw.includes(CRLF);
+    const original = usedCRLF ? raw.split(CRLF).join("\n") : raw;
+    if (!original.includes("const buildMessageBase = ")) {
+      continue;
+    }
+    // Only this patch's own marker counts as "already patched" — the sibling
+    // mixed-attachment patch leaves its marker in the same file.
+    if (original.includes(MARKER)) {
+      return { patched: false, file, reason: "already patched" };
+    }
+    const upstream = UPSTREAM_HINTS.find((hint) => original.includes(hint));
+    if (upstream) {
+      return { patched: false, file, reason: "upstream maps replyTargetGuid" };
+    }
+    let patched = replaceOnce(
+      original,
+      ANCHOR,
+      REPLACEMENT,
+      "buildMessageBase return object"
+    );
+    patched = `// ${MARKER}\n${patched}`;
+    if (usedCRLF) {
+      patched = patched.split("\n").join(CRLF);
+    }
+    fs.writeFileSync(file, patched, "utf8");
+    return { patched: true, file };
+  }
+  throw new Error("could not find @spectrum-ts/imessage buildMessageBase chunk to patch");
+}
+
+const _invokedDirectly =
+  process.argv[1] &&
+  import.meta.url === pathToFileURL(process.argv[1]).href;
+if (_invokedDirectly) {
+  try {
+    const root = process.argv[2] ? path.resolve(process.argv[2]) : scriptDir();
+    const result = patchSpectrumReplyTarget(root);
+    const action = result.patched
+      ? "patched"
+      : result.reason === "already patched"
+        ? "ok (already patched)"
+        : `skipped (${result.reason})`;
+    console.error(`photon-sidecar: spectrum reply-target patch ${action}: ${result.file}`);
+  } catch (err) {
+    console.error(`photon-sidecar: spectrum reply-target patch failed: ${err?.stack || err}`);
+    process.exit(1);
+  }
+}
diff --git a/tests/plugins/platforms/photon/test_spectrum_reply_patch.py b/tests/plugins/platforms/photon/test_spectrum_reply_patch.py
new file mode 100644
index 0000000..a6599ae
--- /dev/null
+++ b/tests/plugins/platforms/photon/test_spectrum_reply_patch.py
@@ -0,0 +1,296 @@
+"""Regression tests for Hermes' Spectrum reply-linkage workaround.
+
+`@spectrum-ts/imessage@8.0.0` builds every emitted message from a single
+`buildMessageBase` helper that drops the Apple reply linkage
+(`replyTargetGuid` / `threadOriginatorGuid` / `threadOriginatorPart`) the
+underlying `@photon-ai/advanced-imessage` record already carries. The install
+-time patch under test re-attaches it as a `replyTo` object.
+
+These tests never spawn the sidecar and never touch the checked-out
+`node_modules` copy: every run gets its own temp root seeded from the real
+dist, and a module-scoped guard asserts the real dist is byte-identical
+afterwards.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+_SIDECAR = Path("plugins/platforms/photon/sidecar")
+_PATCHER = _SIDECAR / "patch-spectrum-reply-target.mjs"
+_MIXED_PATCHER = _SIDECAR / "patch-spectrum-mixed-attachments.mjs"
+_REAL_DIST = _SIDECAR / "node_modules/@spectrum-ts/imessage/dist/index.js"
+_PACKAGE_JSON = _SIDECAR / "package.json"
+
+_MARKER = "Hermes patch: Preserve Apple reply linkage (replyTargetGuid/threadOriginatorGuid)"
+_MIXED_MARKER = "Hermes patch: Preserve mixed text + attachment iMessage payloads"
+_MARKER_LINE = f"// {_MARKER}\n"
+
+_POSTINSTALL = (
+    "node patch-spectrum-mixed-attachments.mjs && node patch-spectrum-reply-target.mjs"
+)
+
+# The published 8.x helper, verbatim (tab-indented, as the tarball ships it).
+_ANCHOR = (
+    "const buildMessageBase = (message, chatGuidHint, timestamp, phone) => {\n"
+    "\tconst chat = resolveChatGuid(message, chatGuidHint);\n"
+    "\treturn {\n"
+    '\t\tdirection: message.isFromMe ? "outbound" : "inbound",\n'
+    "\t\tsender: toSenderRef(message.sender),\n"
+    "\t\tspace: {\n"
+    "\t\t\tid: chat,\n"
+    "\t\t\ttype: chatTypeFromGuid(chat),\n"
+    "\t\t\tphone\n"
+    "\t\t},\n"
+    "\t\ttimestamp\n"
+    "\t};\n"
+    "};"
+)
+
+_REPLACEMENT = (
+    "const buildMessageBase = (message, chatGuidHint, timestamp, phone) => {\n"
+    "\tconst chat = resolveChatGuid(message, chatGuidHint);\n"
+    "\treturn {\n"
+    '\t\tdirection: message.isFromMe ? "outbound" : "inbound",\n'
+    "\t\tsender: toSenderRef(message.sender),\n"
+    "\t\tspace: {\n"
+    "\t\t\tid: chat,\n"
+    "\t\t\ttype: chatTypeFromGuid(chat),\n"
+    "\t\t\tphone\n"
+    "\t\t},\n"
+    "\t\ttimestamp,\n"
+    "\t\t// Hermes patch: Apple reply linkage. replyTargetGuid = the exact tapped"
+    " bubble; threadOriginatorGuid = thread root.\n"
+    "\t\t...(message.replyTargetGuid || message.threadOriginatorGuid ? { replyTo: {\n"
+    "\t\t\tid: message.replyTargetGuid ?? message.threadOriginatorGuid,\n"
+    "\t\t\tthreadRootId: message.threadOriginatorGuid ?? null,\n"
+    "\t\t\tpart: message.threadOriginatorPart ?? null\n"
+    "\t\t} } : {})\n"
+    "\t};\n"
+    "};"
+)
+
+if shutil.which("node") is None or not _REAL_DIST.exists():
+    pytest.skip(
+        "needs node and an installed @spectrum-ts/imessage dist to seed fixtures",
+        allow_module_level=True,
+    )
+
+_REAL_DIST_BYTES = _REAL_DIST.read_bytes()
+_REAL_DIST_SHA = hashlib.sha256(_REAL_DIST_BYTES).hexdigest()
+
+
+@pytest.fixture(autouse=True)
+def _real_dist_untouched():
+    """The checked-out provider copy is a fixture *source*, never a patch target."""
+    yield
+    assert hashlib.sha256(_REAL_DIST.read_bytes()).hexdigest() == _REAL_DIST_SHA, (
+        "the real @spectrum-ts/imessage dist under node_modules was modified"
+    )
+
+
+def _seed(root: Path, source: str | None = None) -> Path:
+    """Lay out `<root>/node_modules/@spectrum-ts/imessage/dist/index.js`."""
+    dist = root / "node_modules" / "@spectrum-ts" / "imessage" / "dist"
+    dist.mkdir(parents=True, exist_ok=True)
+    chunk = dist / "index.js"
+    chunk.write_text(
+        _REAL_DIST_BYTES.decode("utf-8") if source is None else source,
+        encoding="utf-8",
+    )
+    return chunk
+
+
+def _run(script: Path, root: Path) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        ["node", str(script), str(root)],
+        cwd=Path.cwd(),
+        text=True,
+        capture_output=True,
+        check=False,
+    )
+
+
+def test_first_run_rewrites_build_message_base(tmp_path: Path) -> None:
+    """One anchor covers every emitted message: `buildMessageBase`'s return."""
+    chunk = _seed(tmp_path)
+    original = chunk.read_text(encoding="utf-8")
+    assert original.count(_ANCHOR) == 1, "fixture drifted from the published 8.x helper"
+
+    result = _run(_PATCHER, tmp_path)
+    assert result.returncode == 0, result.stderr
+    assert "spectrum reply-target patch patched: " in result.stderr
+
+    patched = chunk.read_text(encoding="utf-8")
+    assert _MARKER in patched
+    assert "replyTo: {" in patched
+    assert patched.count(_REPLACEMENT) == 1
+    assert _ANCHOR not in patched
+    # Nothing outside the one anchor moved.
+    assert patched == _MARKER_LINE + original.replace(_ANCHOR, _REPLACEMENT)
+
+    # The rewritten chunk is still a parseable ES module.
+    probe = tmp_path / "parse-probe.mjs"
+    probe.write_text(patched, encoding="utf-8")
+    check = subprocess.run(
+        ["node", "--check", str(probe)], text=True, capture_output=True, check=False
+    )
+    assert check.returncode == 0, check.stderr
+
+
+def test_patched_helper_emits_apple_reply_linkage(tmp_path: Path) -> None:
+    """Evaluate the rewritten helper: the linkage lands on the message base."""
+    chunk = _seed(tmp_path)
+    assert _run(_PATCHER, tmp_path).returncode == 0
+    patched = chunk.read_text(encoding="utf-8")
+    assert _REPLACEMENT in patched
+
+    harness = tmp_path / "harness.mjs"
+    harness.write_text(
+        "const resolveChatGuid = (message, hint) => hint;\n"
+        "const chatTypeFromGuid = (guid) => (guid.endsWith(';+;g') ? 'group' : 'dm');\n"
+        "const toSenderRef = (sender) => ({ id: sender });\n"
+        f"{_REPLACEMENT}\n"
+        "const cases = [\n"
+        "  { isFromMe: false, sender: 'a', replyTargetGuid: 'G1',"
+        " threadOriginatorGuid: 'G0', threadOriginatorPart: 2 },\n"
+        "  { isFromMe: false, sender: 'a', threadOriginatorGuid: 'G0' },\n"
+        "  { isFromMe: false, sender: 'a', replyTargetGuid: 'G1' },\n"
+        "  { isFromMe: true, sender: 'a' },\n"
+        "];\n"
+        "console.log(JSON.stringify(cases.map((m) =>"
+        " buildMessageBase(m, 'iMessage;-;+1', 7, '+1'))));\n",
+        encoding="utf-8",
+    )
+    out = subprocess.run(
+        ["node", str(harness)], text=True, capture_output=True, check=False
+    )
+    assert out.returncode == 0, out.stderr
+    bases = json.loads(out.stdout)
+
+    # A tapped bubble inside a thread: exact target plus the thread root.
+    assert bases[0]["replyTo"] == {"id": "G1", "threadRootId": "G0", "part": 2}
+    # Thread membership with no explicit target falls back to the root.
+    assert bases[1]["replyTo"] == {"id": "G0", "threadRootId": "G0", "part": None}
+    # A reply with no thread record still carries the tapped bubble.
+    assert bases[2]["replyTo"] == {"id": "G1", "threadRootId": None, "part": None}
+    # A plain message gains no key at all — downstream shape is unchanged.
+    assert "replyTo" not in bases[3]
+    assert bases[3] == {
+        "direction": "outbound",
+        "sender": {"id": "a"},
+        "space": {"id": "iMessage;-;+1", "type": "dm", "phone": "+1"},
+        "timestamp": 7,
+    }
+
+
+def test_second_run_is_a_no_op(tmp_path: Path) -> None:
+    """postinstall runs on every `npm install`; re-patching must not stack."""
+    chunk = _seed(tmp_path)
+    assert _run(_PATCHER, tmp_path).returncode == 0
+    once = chunk.read_bytes()
+
+    again = _run(_PATCHER, tmp_path)
+    assert again.returncode == 0, again.stderr
+    assert "already patched" in again.stderr
+    assert "spectrum reply-target patch ok" in again.stderr
+    assert chunk.read_bytes() == once
+
+
+@pytest.mark.parametrize(
+    "upstream",
+    [
+        pytest.param("const replyTargetGuid = (message) =>", id="declaration"),
+        pytest.param("const target = replyTargetGuid(message);", id="call-site"),
+    ],
+)
+def test_skips_when_upstream_maps_reply_target(tmp_path: Path, upstream: str) -> None:
+    """spectrum-ts >= 12 maps the linkage natively — stand down, don't fight it."""
+    seeded = f"{upstream} message.reply_target_guid ?? null;\n" + _REAL_DIST_BYTES.decode(
+        "utf-8"
+    )
+    chunk = _seed(tmp_path, seeded)
+    before = chunk.read_bytes()
+
+    result = _run(_PATCHER, tmp_path)
+    assert result.returncode == 0, result.stderr
+    assert "spectrum reply-target patch skipped" in result.stderr
+    assert "upstream maps replyTargetGuid" in result.stderr
+    assert chunk.read_bytes() == before
+    assert _MARKER not in chunk.read_text(encoding="utf-8")
+
+
+def test_missing_anchor_fails_loudly(tmp_path: Path) -> None:
+    """A reshaped helper must break the install, not silently ship no linkage."""
+    reshaped = _REAL_DIST_BYTES.decode("utf-8").replace(
+        _ANCHOR, _ANCHOR.replace("\t\tsender: toSenderRef(message.sender),\n", ""), 1
+    )
+    chunk = _seed(tmp_path, reshaped)
+    before = chunk.read_bytes()
+    assert "const buildMessageBase = " in reshaped
+    assert _ANCHOR not in reshaped
+
+    result = _run(_PATCHER, tmp_path)
+    assert result.returncode == 1
+    assert "buildMessageBase" in result.stderr
+    assert "found 0" in result.stderr
+    assert "spectrum reply-target patch failed" in result.stderr
+    assert chunk.read_bytes() == before
+
+
+def test_missing_dist_fails_loudly(tmp_path: Path) -> None:
+    """No provider dist at all is an install problem worth surfacing."""
+    (tmp_path / "node_modules").mkdir()
+    result = _run(_PATCHER, tmp_path)
+    assert result.returncode == 1
+    assert "@spectrum-ts/imessage dist not found" in result.stderr
+
+
+def test_composes_with_the_mixed_attachment_patch_in_either_order(
+    tmp_path: Path,
+) -> None:
+    """The two patches touch disjoint anchors, so order must not matter."""
+    forward_root = tmp_path / "forward"
+    reverse_root = tmp_path / "reverse"
+    forward = _seed(forward_root)
+    reverse = _seed(reverse_root)
+    original = forward.read_text(encoding="utf-8")
+
+    for script in (_MIXED_PATCHER, _PATCHER):
+        assert _run(script, forward_root).returncode == 0
+    for script in (_PATCHER, _MIXED_PATCHER):
+        assert _run(script, reverse_root).returncode == 0
+
+    for chunk in (forward, reverse):
+        text = chunk.read_text(encoding="utf-8")
+        assert _MARKER in text
+        assert _MIXED_MARKER in text
+        assert text.count(_REPLACEMENT) == 1
+
+    # Order-independent to the byte.
+    assert forward.read_bytes() == reverse.read_bytes()
+
+    # Re-running either script on either root changes nothing.
+    for root, chunk in ((forward_root, forward), (reverse_root, reverse)):
+        settled = chunk.read_bytes()
+        for script in (_MIXED_PATCHER, _PATCHER):
+            assert _run(script, root).returncode == 0
+            assert chunk.read_bytes() == settled
+
+    # Disjointness, proved by subtraction: undo this patch's single edit and the
+    # mixed-attachment patch's output comes back byte-for-byte.
+    undone = forward.read_text(encoding="utf-8")
+    assert undone.startswith(_MARKER_LINE)
+    assert undone[len(_MARKER_LINE) :].replace(_REPLACEMENT, _ANCHOR, 1) == original
+
+
+def test_postinstall_chains_both_patches() -> None:
+    """Both patches run on every install, mixed-attachments first."""
+    package = json.loads(_PACKAGE_JSON.read_text(encoding="utf-8"))
+    assert package["scripts"]["postinstall"] == _POSTINSTALL
-- 
