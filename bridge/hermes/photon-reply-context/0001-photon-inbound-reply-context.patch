+        "id": "spc-msg-SELF",
+        "replyTo": {
+            "id": "spc-msg-SELF",
+            "threadRootId": "spc-msg-SELF",
+            "part": None,
+        },
+        "content": _INNER,
+    },
+    "self_reference_wrapped": {
+        "id": "spc-msg-SELF",
+        "content": {
+            "type": "reply",
+            "content": _INNER,
