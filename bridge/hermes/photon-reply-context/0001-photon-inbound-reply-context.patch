+"""Behavior tests for the Photon sidecar's inbound reply-linkage normalizer.
+
+A human tapping "Reply" on an iMessage bubble produces Apple reply linkage on
+the inbound record. Two SDK shapes carry it:
+
+* patched `@spectrum-ts/imessage@8.0.0` (Hermes' install-time patch) hangs a
+  `message.replyTo = {id, threadRootId, part}` off every message;
+* spectrum-ts >= 12 instead wraps the content:
+  `message.content = {type: "reply", content: <inner>, target: <Message>}`.
+
+`plugins/platforms/photon/sidecar/reply-context.mjs` collapses both into one
+shape for the sidecar. These tests *execute* that real module under node —
+they do not read its source. `index.mjs` itself cannot run locally (no
+`node_modules`), so it is only syntax-checked and grepped.
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import subprocess
+from pathlib import Path
+from typing import Any, Dict
+
+import pytest
+
+if shutil.which("node") is None:
+    pytest.skip("needs node to execute the sidecar module", allow_module_level=True)
+
+_ROOT = Path(__file__).resolve().parents[4]
+_SIDECAR = _ROOT / "plugins" / "platforms" / "photon" / "sidecar"
+_MODULE = _SIDECAR / "reply-context.mjs"
+_INDEX = _SIDECAR / "index.mjs"
+
+
+def _run_harness(body: str, payload: Dict[str, Any]) -> Dict[str, Any]:
+    """Feed `payload` as JSON stdin to a node ESM harness; parse its JSON stdout."""
+    harness = (
+        f"import {{ replyTargetOf, messageText, TARGET_TEXT_CAP }} "
+        f"from {json.dumps(_MODULE.as_uri())};\n"
+        "const chunks = [];\n"
+        "process.stdin.on('data', (c) => chunks.push(c));\n"
+        "process.stdin.on('end', () => {\n"
+        "  const cases = JSON.parse(Buffer.concat(chunks).toString('utf-8'));\n"
+        "  const out = {};\n"
+        f"{body}"
+        "  process.stdout.write(JSON.stringify(out));\n"
+        "});\n"
+    )
+    run = subprocess.run(
+        ["node", "--input-type=module", "-e", harness],
+        input=json.dumps(payload),
+        text=True,
+        capture_output=True,
+        check=False,
+    )
+    assert run.returncode == 0, run.stderr
+    return json.loads(run.stdout)
+
+
+# --------------------------------------------------------------------------
+# replyTargetOf
+
+_INNER = {"type": "text", "text": "hi"}
+
+_REPLY_CASES: Dict[str, Any] = {
+    # Patched 8.0.0 shape: linkage rides beside the untouched content.
+    "patched_shape": {
+        "id": "spc-msg-SELF",
+        "replyTo": {
+            "id": "spc-msg-A",
+            "threadRootId": "spc-msg-R",
+            "part": "0:0:0",
+        },
+        "content": _INNER,
+    },
+    # Multipart child ids arrive prefixed `p:<partIndex>/<parentGuid>`.
+    "patched_part_prefixed_id": {
+        "id": "spc-msg-SELF",
+        "replyTo": {"id": "p:2/spc-msg-A", "threadRootId": None, "part": None},
+        "content": _INNER,
+    },
+    # spectrum-ts >= 12 wraps the content and hydrates the full target.
+    "wrapped_12x_shape": {
+        "id": "spc-msg-SELF",
+        "content": {
+            "type": "reply",
+            "content": _INNER,
+            "target": {
+                "id": "spc-msg-T",
+                "direction": "outbound",
+                "content": {"type": "text", "text": "earlier"},
+            },
+        },
+    },
+    # A blank id is no linkage at all.
+    "blank_id": {"id": "spc-msg-SELF", "replyTo": {"id": "   "}, "content": _INNER},
+    "missing_reply_to": {"id": "spc-msg-SELF", "content": _INNER},
+    "non_object_message": "not-a-message",
+    "null_message": None,
