From 6df20d5e30a166f5dbc715061534e5cf831c6ea6 Mon Sep 17 00:00:00 2001
From: Rivian <rivianp@gmail.com>
Date: Thu, 10 Sep 2026 02:59:04 +0700
Subject: [PATCH 6/6] photon: reply-target patch tests derive a pristine
 fixture from an already-patched dist
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The suite seeded every temp root from the installed dist and assumed it was
untouched. That holds in a checkout, not on a Hermes box: there the sidecar is
installed, `postinstall` has run, and the dist already carries the rewrites
under test, so seven tests failed as "fixture drifted from the published 8.x
helper" — the fixture, not the code.

So the fixture is now derived. `_pristine` backs this patch's own work out of
whatever it reads: each rewrite replaced by its anchor, the marker line dropped
(only ours — the mixed-attachment patch's marker belongs in the fixture), and a
pristine file passed through untouched. It recognises the pre-coercion
`buildMessageBase` form as well as the current one, since a box patched before
that change is exactly the case this exists for. `_require_pristine` then
refuses to hand the tests a half-inverted fixture, naming what it could not
undo instead of failing later as drift.

`PHOTON_REPLY_PATCH_FIXTURE` points the seed at another dist, so the
already-patched path can be run on demand rather than only on a real box.
---
 .../photon/test_spectrum_reply_patch.py       | 135 ++++++++++++++----
 1 file changed, 111 insertions(+), 24 deletions(-)

diff --git a/tests/plugins/platforms/photon/test_spectrum_reply_patch.py b/tests/plugins/platforms/photon/test_spectrum_reply_patch.py
index c129fa1..58516a8 100644
--- a/tests/plugins/platforms/photon/test_spectrum_reply_patch.py
+++ b/tests/plugins/platforms/photon/test_spectrum_reply_patch.py
@@ -14,16 +14,25 @@ second anchor: the provider's `messageSchema` declaration, which gains a
 `replyTo` shape. The two rewrites are independently idempotent, because the
 production dist already carries the first one from an earlier release.
 
-These tests never spawn the sidecar and never touch the checked-out
-`node_modules` copy: every run gets its own temp root seeded from the real
-dist, and a module-scoped guard asserts the real dist is byte-identical
-afterwards.
+These tests never spawn the sidecar and never touch the installed
+`node_modules` copy: every run gets its own temp root seeded from that dist,
+and a module-scoped guard asserts the source dist is byte-identical afterwards.
+
+The seed is a *pristine* dist, derived rather than assumed. In this checkout
+the installed copy has never been patched, but on a real Hermes box the sidecar
+is installed, `postinstall` has already run, and the dist on disk carries the
+very rewrites under test — which would otherwise fail every fixture as
+"drifted". So `_pristine` inverts whatever this patch left behind before
+anything is seeded, and fails loudly if it cannot get back to the published
+8.x shapes. Point `PHOTON_REPLY_PATCH_FIXTURE` at another dist to exercise that
+path deliberately.
 """
 
 from __future__ import annotations
 
 import hashlib
 import json
+import os
 import shutil
 import subprocess
 from pathlib import Path
@@ -116,23 +125,109 @@ _SCHEMA_REPLACEMENT = (
 _BASE_DONE = "Hermes patch: Apple reply linkage. replyTargetGuid"
 _SCHEMA_DONE = "Hermes patch: Apple reply linkage survives extractExtras"
 
-if shutil.which("node") is None or not _REAL_DIST.exists():
+# The `buildMessageBase` rewrite as shipped today, and as shipped before the
+# string coercion landed. An installed box can be carrying either, so the
+# inverter has to recognise both to get back to the published helper.
+_LEGACY_REPLACEMENT = _REPLACEMENT.replace(
+    "threadRootId: message.threadOriginatorGuid != null"
+    " ? String(message.threadOriginatorGuid) : null,",
+    "threadRootId: message.threadOriginatorGuid ?? null,",
+).replace(
+    "part: message.threadOriginatorPart != null"
+    " ? String(message.threadOriginatorPart) : null",
+    "part: message.threadOriginatorPart ?? null",
+)
+assert _LEGACY_REPLACEMENT != _REPLACEMENT, "coercion shape moved; update the inverter"
+
+# Each anchor, against every form this patch is known to have emitted for it.
+_REWRITE_FORMS = (
+    ("buildMessageBase", _ANCHOR, (_REPLACEMENT, _LEGACY_REPLACEMENT)),
+    ("messageSchema", _SCHEMA_ANCHOR, (_SCHEMA_REPLACEMENT,)),
+)
+
+# Where the fixture is seeded from. Defaults to the installed dist; the override
+# exists so the "seeded from an already-patched dist" path can be exercised on
+# purpose, since in this checkout the installed copy happens to be pristine.
+_FIXTURE_ENV = "PHOTON_REPLY_PATCH_FIXTURE"
+_override = os.environ.get(_FIXTURE_ENV)
+_DIST_SOURCE = Path(_override) if _override else _REAL_DIST
+
+if shutil.which("node") is None or not _DIST_SOURCE.exists():
     pytest.skip(
         "needs node and an installed @spectrum-ts/imessage dist to seed fixtures",
         allow_module_level=True,
     )
 
-_REAL_DIST_BYTES = _REAL_DIST.read_bytes()
-_REAL_DIST_SHA = hashlib.sha256(_REAL_DIST_BYTES).hexdigest()
+
+def _pristine(source: str) -> str:
+    """The published 8.x dist, with this patch's own work backed out.
+
+    On a developer checkout that is the file as read. On an installed box
+    `postinstall` has already run, so the rewrites under test are sitting in the
+    dist; seeding from that would fail every anchor assertion. Inverting is safe
+    because each rewrite is a single exact substitution with a known inverse.
+    """
+    if not (_MARKER in source or _BASE_DONE in source or _SCHEMA_DONE in source):
+        return source
+    for _name, anchor, emitted in _REWRITE_FORMS:
+        for form in emitted:
+            if form in source:
+                source = source.replace(form, anchor, 1)
+                break
+    # Only this patch's marker line goes; the sibling mixed-attachment patch
+    # leaves its own at the top of the same file and belongs in the fixture.
+    source = source.replace(_MARKER_LINE, "", 1)
+    return source
+
+
+def _require_pristine(source: str) -> str:
+    """Fail loudly rather than hand a half-inverted fixture to the tests."""
+    leftovers = [
+        name
+        for name, probe in (
+            ("marker", _MARKER),
+            ("buildMessageBase", _BASE_DONE),
+            ("messageSchema", _SCHEMA_DONE),
+        )
+        if probe in source
+    ]
+    missing = [
+        f"{name} x{source.count(anchor)}"
+        for name, anchor, _emitted in _REWRITE_FORMS
+        if source.count(anchor) != 1
+    ]
+    if leftovers or missing:
+        raise RuntimeError(
+            f"cannot derive a pristine @spectrum-ts/imessage dist from {_DIST_SOURCE}: "
+            f"still patched {leftovers or '[]'}, anchors not found exactly once "
+            f"{missing or '[]'}. Either the published 8.x shapes moved, or this dist "
+            f"carries a patch form the inverter does not know. Set {_FIXTURE_ENV} to a "
+            f"pristine dist, or update the anchors."
+        )
+    return source
+
+
+_SOURCE_BYTES = _DIST_SOURCE.read_bytes()
+_PRISTINE = _require_pristine(_pristine(_SOURCE_BYTES.decode("utf-8")))
+
+# Every file these tests read as a fixture source, guarded by content hash. The
+# installed dist is included even when an override supersedes it: "never write
+# to node_modules" is the rule regardless of what was read.
+_GUARDED = {
+    path: hashlib.sha256(path.read_bytes()).hexdigest()
+    for path in {_DIST_SOURCE, _REAL_DIST}
+    if path.exists()
+}
 
 
 @pytest.fixture(autouse=True)
 def _real_dist_untouched():
-    """The checked-out provider copy is a fixture *source*, never a patch target."""
