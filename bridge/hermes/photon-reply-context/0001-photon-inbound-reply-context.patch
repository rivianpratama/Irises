+            ],
+        }
+    },
+    "attachment_only": {"content": {"type": "attachment", "name": "a.png"}},
+    "empty_text": {"content": {"type": "text", "text": ""}},
+    "no_content": {},
+    "null_target": None,
+    "long_text": {"content": {"type": "text", "text": _LONG}},
