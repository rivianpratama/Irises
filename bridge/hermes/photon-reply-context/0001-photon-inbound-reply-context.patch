+
+
+@pytest.fixture(scope="module")
+def texts() -> Dict[str, Any]:
+    out = _run_harness(
+        "  for (const [name, target] of Object.entries(cases)) {\n"
+        "    out[name] = messageText(target);\n"
+        "  }\n"
+        "  out.__cap = TARGET_TEXT_CAP;\n",
+        _TEXT_CASES,
