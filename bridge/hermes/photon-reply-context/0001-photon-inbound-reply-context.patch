Subject: [PATCH 2/6] photon: forward Apple reply linkage from the sidecar
 (replyTo on inbound events)

---
 plugins/platforms/photon/sidecar/index.mjs    | 170 ++++++++---
 .../photon/sidecar/reply-context.mjs          | 128 +++++++++
 .../platforms/photon/test_reply_context.py    | 268 ++++++++++++++++++
 3 files changed, 533 insertions(+), 33 deletions(-)
 create mode 100644 plugins/platforms/photon/sidecar/reply-context.mjs
 create mode 100644 tests/plugins/platforms/photon/test_reply_context.py

diff --git a/plugins/platforms/photon/sidecar/index.mjs b/plugins/platforms/photon/sidecar/index.mjs
index 5c8611f..491157f 100644
--- a/plugins/platforms/photon/sidecar/index.mjs
+++ b/plugins/platforms/photon/sidecar/index.mjs
@@ -17,6 +17,14 @@
 // Protocol (all requests require `X-Hermes-Sidecar-Token: ${TOKEN}`):
 //   - GET  /inbound    -> 200 NDJSON stream; one JSON event per line, blank
 //                         lines are heartbeats. One consumer at a time.
+//       Each event: {"messageId", "platform", "space", "sender", "content",
+//              "timestamp",
+//              "replyTo": {"id", "threadRootId", "part", "direction",
+//                          "text", "src"} | null}
+//       `replyTo` is present on every event and non-null only when the human
+//       tapped Reply on a bubble: `id` is the replied-to message (the SDK id
+//       once resolved), `direction`/`text` describe that bubble when it could
+//       be resolved, and `src` says how ("12x" | "cache" | "fetch" | "none").
 //   - POST /healthz     -> {"ok": true}
 //   - POST /send        -> {"ok": true, "messageId": "..."}
 //       body: {"spaceId": "...", "text": "...",
@@ -61,12 +69,19 @@
 //                          detection so a dead gateway can't orphan us)
 //   PHOTON_TELEMETRY       enable Spectrum SDK telemetry ("true"/"1"/"on"/"yes";
 //                          default off — toggle with `hermes photon telemetry`)
+//   PHOTON_REPLY_HYDRATE_MS  budget (ms) for the one `space.getMessage` used to
+//                          resolve a reply target that isn't already cached
+//                          (default 1500; 0 disables the fetch entirely)
 
 import http from "node:http";
 import crypto from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
 import { once } from "node:events";
 import { patchSpectrumTs } from "./patch-spectrum-mixed-attachments.mjs";
 import { chooseSendFormat } from "./send-format.mjs";
+import { replyTargetOf, messageText } from "./reply-context.mjs";
 import {
   classifyProbeRejection,
   shouldProbe,
@@ -93,7 +108,15 @@ const DM_CHAT_GUID_RE = /^any;-;(\+\d{6,})$/;
 const E164_RE = /^\+\d{6,}$/;
 const MAX_KNOWN_SPACES = 2048;
 const MAX_KNOWN_MESSAGES = 1024;
+const MAX_KNOWN_OUTBOUND_MESSAGES = 256;
 const MAX_REACTION_HANDLES = 512;
