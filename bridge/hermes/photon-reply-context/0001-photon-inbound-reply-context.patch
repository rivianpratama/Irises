--- /dev/null
+++ b/plugins/platforms/photon/sidecar/reply-context.mjs
@@ -0,0 +1,128 @@
+// Inbound reply linkage for the Photon sidecar — normalize the two shapes
+// spectrum-ts can hand us into one reply-target descriptor.
+//
+// A human tapping "Reply" on a bubble produces Apple linkage on the record:
+// `replyTargetGuid` (the exact bubble tapped), `threadOriginatorGuid` (the
+// thread's root bubble) and `threadOriginatorPart`. How that reaches us
+// depends on the SDK:
+//
+//   patched 8.0.0 — Hermes' install-time patch (patch-spectrum-reply-target.mjs)
+//     re-attaches the linkage beside the content:
+//       message.replyTo = { id, threadRootId, part }
+//     and `message.content` is the reply's own content, untouched.
+//   spectrum-ts >= 12 — upstream maps it itself, but by WRAPPING the content:
+//       message.content = { type: "reply", content: <inner>, target: <Message> }
+//     The target is a full Message, so no round trip is needed to preview it.
+//
+// This module is pure (no spectrum-ts import, no I/O) so the tests can execute
+// the real decision logic under node — index.mjs itself can't run without an
+// installed SDK. See tests/plugins/platforms/photon/test_reply_context.py.
+
+// Multipart child ids arrive as `p:<partIndex>/<parentGuid>`; the bare parent
+// guid is what `space.getMessage` and the adapter's caches key on.
+export const PART_PREFIX = /^p:(\d+)\//;
+
+// Cap the target-text preview so one long bubble can't balloon an NDJSON line.
+export const TARGET_TEXT_CAP = 2000;
+
+/**
+ * Split a possibly `p:N/`-prefixed message id into its bare id + part index.
+ *
+ * @param {unknown} raw
+ * @returns {{id: string, partIndex: number|null}|null} null for a
+ *   missing/blank id (a reply target we can't address is no target at all).
+ */
+function splitMessageId(raw) {
+  if (typeof raw !== "string") return null;
+  const trimmed = raw.trim();
+  if (!trimmed) return null;
+  const m = trimmed.match(PART_PREFIX);
+  if (!m) return { id: trimmed, partIndex: null };
+  const id = trimmed.slice(m[0].length).trim();
+  if (!id) return null;
+  return { id, partIndex: Number(m[1]) };
+}
+
+/**
+ * Describe the message a reply points at, across both SDK shapes.
+ *
+ * @param {any} message an SDK Message (or anything — non-objects yield null)
+ * @returns {{id: string, threadRootId: string|null, part: string|null,
+ *            partIndex: number|null, target: any, content: any}|null}
+ *   null when the message carries no usable reply linkage. `content` is
+ *   always the content the sidecar should forward (the inner content on the
+ *   12.x wrapper, the message's own content otherwise).
+ */
+export function replyTargetOf(message) {
+  if (!message || typeof message !== "object") return null;
+
+  const linkage =
+    message.replyTo && typeof message.replyTo === "object"
+      ? message.replyTo
+      : null;
+  const content =
+    message.content && typeof message.content === "object"
+      ? message.content
+      : null;
+  const wrapped = content !== null && content.type === "reply";
+  if (!linkage && !wrapped) return null;
+
+  // 12.x wins for target/content; `message.replyTo` fills in the rest (and
+  // the id, when the wrapper arrived without a hydrated target).
+  const target = wrapped ? content.target ?? null : null;
+  const inner = wrapped ? content.content : message.content;
+  const split =
+    (target && typeof target === "object" ? splitMessageId(target.id) : null) ??
+    (linkage ? splitMessageId(linkage.id) : null);
+  if (!split) return null;
+
+  // A thread's root bubble can carry `threadOriginatorGuid` pointing at
+  // itself. That is a thread marker, not a reply — forwarding it would make
+  // every root bubble look like a reply to itself.
+  const self = splitMessageId(message.id);
+  if (self && self.id === split.id) return null;
+
+  return {
+    id: split.id,
+    threadRootId: linkage ? linkage.threadRootId ?? null : null,
+    part: linkage ? linkage.part ?? null : null,
+    partIndex: split.partIndex,
+    target,
+    content: inner,
+  };
+}
+
+/**
+ * Best-effort text preview of a resolved target Message, so the Python adapter
+ * can populate the gateway's `reply_to_text` (context: WHAT was replied to or
+ * tapped back). Handles plain text, rich links and our patched mixed
+ * text+attachment groups (first text/richlink child); null for
+ * attachment/voice-only targets.
+ *
+ * @param {any} target a hydrated Message (or null)
+ * @returns {string|null} at most TARGET_TEXT_CAP characters
+ */
+export function messageText(target) {
+  const c = target && typeof target === "object" ? target.content : null;
+  if (!c || typeof c !== "object") return null;
+  let text = null;
+  if (c.type === "text") {
+    text = c.text;
+  } else if (c.type === "richlink") {
+    text = c.url;
+  } else if (c.type === "group") {
+    for (const item of Array.isArray(c.items) ? c.items : []) {
+      const ic = item && typeof item === "object" ? item.content : null;
+      if (ic && ic.type === "text" && ic.text) {
+        text = ic.text;
+        break;
+      }
+      if (ic && ic.type === "richlink" && ic.url) {
+        text = ic.url;
+        break;
+      }
+    }
+  }
+  if (typeof text !== "string" || !text) return null;
+  return text.length > TARGET_TEXT_CAP ? text.slice(0, TARGET_TEXT_CAP) : text;
+}
